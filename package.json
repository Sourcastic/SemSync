{
  "name": "semsync-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "start:server": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "node tests/concurrency.test.js",
    "test:timing": "node tests/timing.test.js",
    "test:sync": "node tests/peer-sync.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "@automerge/automerge": "^3.5.0"
  }
}
