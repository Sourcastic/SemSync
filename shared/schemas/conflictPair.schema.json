{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConflictPair",
  "type": "object",
  "required": [
    "conflictId",
    "documentId",
    "premise",
    "hypothesis",
    "span",
    "status"
  ],
  "properties": {
    "conflictId": {
      "type": "string",
      "description": "Unique identifier for the detected concurrent conflict"
    },
    "documentId": {
      "type": "string",
      "description": "The Automerge document URL or ID"
    },
    "premise": {
      "type": "object",
      "required": ["peerId", "text", "changeHead"],
      "properties": {
        "peerId": { "type": "string" },
        "text": { "type": "string" },
        "changeHead": { "type": "string" }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": ["peerId", "text", "changeHead"],
      "properties": {
        "peerId": { "type": "string" },
        "text": { "type": "string" },
        "changeHead": { "type": "string" }
      }
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer" },
        "end": { "type": "integer" }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["CONTRADICTION", "ENTAILMENT", "NEUTRAL", "GRAMMAR_ERROR"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suggestion": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["DETECTED", "PENDING_RESOLUTION", "RESOLVED", "DISMISSED"],
      "default": "DETECTED"
    }
  }
}
